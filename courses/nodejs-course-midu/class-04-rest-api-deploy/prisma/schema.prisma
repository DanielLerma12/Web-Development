generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  year     Int
  director String
  duration Int
  poster   String?
  rate     Decimal
  genres   Genre[] @relation("GenreToMovie")
}

model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  movies Movie[] @relation("GenreToMovie")
}
